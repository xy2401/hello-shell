{
  "name": "hello-shell",
  "version": "1.0.0",
  "description": "Shell 与命令行统一任务矩阵：bash/zsh/fish/cmd/PowerShell 同任务对照与真实输出快照 (Shell & Command Line Task Matrix)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.16.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "collect:docker": "node scripts/initialize-docker-evidence.js && node scripts/run-docker-demos.js",
    "collect-outputs": "npm run collect:docker",
    "check:docker-catalog": "node scripts/check-docker-catalog.js",
    "check:matrix-experiments": "node scripts/check-matrix-experiments.js",
    "check:versions": "node scripts/check-version-docs.js",
    "check:installs": "node scripts/check-install-docs.js",
    "check:project": "node scripts/check-project.js",
    "check": "npm run check:versions && npm run check:installs && npm run check:project && npm run check:docker-catalog && npm run check:matrix-experiments && npm run docs:build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fflate": "0.8.3",
    "just-bash": "3.4.2",
    "pyodide": "^314.0.5",
    "v86": "0.5.441",
    "wasi-sh": "^0.2.1",
    "xterm-pty": "^0.12.0"
  }
}
